{
  "name": "saltgui-test",
  "description": "Code linting and testing package for SaltGUI",
  "author": "(initial) Oliver Dunk, (next) Martijn Jacobs, (current) Erwin Dondorp",
  "version": "1.34.0-SNAPSHOT",
  "license": "MIT",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@babel/core": "^8.0.0",
    "@babel/preset-env": "^8.0.0",
    "@babel/register": "^8.0.0",
    "@eslint/js": "^10.0.1",
    "babel-plugin-istanbul": "^8.0.0",
    "chai": "^6.2.2",
    "eslint": "^10.14.0",
    "eslint-plugin-compat": "^7.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "mocha": "^12.0.3",
    "nyc": "^18.0.0",
    "prettier": "^3.9.10",
    "puppeteer": "^25.16.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0"
  },
  "stylelint": {
    "extends": "stylelint-config-standard",
    "rules": {
      "property-no-vendor-prefix": null,
      "color-function-notation": null,
      "color-function-alias-notation": null
    }
  },
  "nyc": {
    "check-coverage": false,
    "per-file": true,
    "lines": 85,
    "statements": 85,
    "functions": 85,
    "branches": 85,
    "cache": true,
    "all": true,
    "watermarks": {
      "lines": [
        70,
        90
      ],
      "functions": [
        70,
        90
      ],
      "branches": [
        70,
        90
      ],
      "statements": [
        70,
        90
      ]
    },
    "exclude": [
      "tests/**/*.js",
      "node_modules/**/*.js"
    ],
    "include": [
      "saltgui/static/scripts/**/*.js"
    ]
  },
  "scripts": {
    "eslint": "eslint saltgui/static/scripts tests/",
    "eslint:fix": "eslint saltgui/static/scripts tests/ --fix",
    "stylelint": "stylelint 'saltgui/static/stylesheets/*.css'",
    "wait-for-docker": "node tests/helpers/wait-for-docker.js",
    "test:unit": "mocha --require @babel/register --trace-warnings --check-leaks --reporter spec tests/unit/",
    "test:functional": "mocha --bail --trace-warnings --check-leaks --reporter spec tests/functional/",
    "test:coverage": "nyc mocha --require @babel/register --trace-warnings --check-leaks --reporter spec tests/unit/",
    "test:year": "grep -e `date +%y` docs/LICENSE.md",
    "format": "prettier --write \"saltgui/static/**/*.{js,css,html}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "jsonpath-plus": "^11.3.0"
  },
  "lint-staged": {
    "saltgui/static/scripts/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "saltgui/static/stylesheets/**/*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "saltgui/static/**/*.html": [
      "prettier --write"
    ]
  }
}
